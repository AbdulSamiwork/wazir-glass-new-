# ==============================================================================
# Wazir Glass & Aluminium - Project Environment Template (Example)
# Duplicate this file as .env and fill in your actual environment settings.
# ==============================================================================

# Database Connection (MySQL / MariaDB via PDO)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=wazir_db
DB_USER=root
DB_PASS=your_db_password

# Cloudinary CDN Configuration
VITE_CLOUDINARY_CLOUD_NAME=your_cloud_name
VITE_CLOUDINARY_API_KEY=your_api_key
VITE_CLOUDINARY_FOLDER=wazir
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
CLOUDINARY_FOLDER=wazir

# API Backend URL
VITE_API_URL=http://localhost/backend_Wazir/api.php
