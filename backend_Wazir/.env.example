
# Wazir Glass & Aluminium - Backend Environment Template (Example)

# Database Connection (MySQL / MariaDB via PDO)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=wazir_db
DB_USER=root
DB_PASS=your_db_password

# Cloudinary CDN Media Delivery & Cloud Uploads
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
CLOUDINARY_FOLDER=wazir

# Security, Sessions & Rate Limiting
APP_ENV=production
APP_DEBUG=false
SESSION_LIFETIME_HOURS=24
